    "half_elf_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Half-elves combine what some say are the best qualities of their elf and human parents."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Semielfos combinan lo que algunos dicen ser las mejores cualidades de sus progenitores humanos y elfos."
          }
        }
      }
    },
    "half_elf_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
