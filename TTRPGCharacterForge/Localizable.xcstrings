    "lawful_evil_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creatures methodically take what they want, within the limits of a code of tradition, loyalty, or order. Devils, blue dragons, and hobgoblins are lawful evil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las criaturas cogen metódicamente aquello que quieren, dentro de los límites de su tradición, lealtad, u orden. Los demonios, dragones azules, y los hobgoblins son legales malvados."
          }
        }
      }
    },
    "lawful_evil_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lawful Evil"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legal Malvado"
          }
        }
      }
    },
    "lawful_good_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creatures can be counted on to do the right thing as expected by society. Gold dragons, paladins, and m ost dwarves are lawful good."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se puede contar con que las criaturas harán lo que la sociedad cree que es lo correcto. Los dragones dorados, paladines, y la mayoría de los enanos son legales buenos."
          }
        }
      }
    },
    "lawful_good_name" : {
      "comment" : "Alignment",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lawful Good"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legal Bueno"
          }
        }
      }
    },
    "lawful_neutral_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "individuals act in accordance with law, tradition, or personal codes. Many monks and some wizards are lawful neutral."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los individuos actúan acorde a la ley, tradiciones, o códigos personales. Muchos monjes y hechiceros son legales neutrales."
          }
        }
      }
    },
