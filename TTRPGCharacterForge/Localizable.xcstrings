    "dragonborn_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dragonborn look very much like dragons standing erect in humanoid form, though they lack wings or a tail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dracónidos se parecen mucho a los dragones que permanecen erectos en forma humanoide, aunque carecen de alas o cola."
          }
        }
      }
    },
