        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A priest of the Old Faith, wielding the powers of nature and adopting animal forms"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sacerdote de la Antigua Fe, que blande los poderes de la naturaleza -la luz de la luna y el crecimiento de las plantas, el fuego y el rayo- y que adopta formas animales."
          }
        }
      }
