      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elves are a magical people of otherworldly grace, living in the world but not entirely part of it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con su gracia no terrenal y sus rasgos delicados, los elfos resultan perturbadoramente hermosos para los humanos y los miembros de muchas otras razas."
          }
        }
      }
