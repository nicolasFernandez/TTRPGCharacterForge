    "half_elf_racial_traits" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+2 Charisma, +1 to Two Other Ability Scores, Darkvision, Fey Ancestry, Skill Versatility"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+2 Carisma, +1 a Otras Dos Puntuaciones de Característica, Visión en la Oscuridad, Ascendencia Feérica, Versatilidad con Habilidades"
          }
        }
      }
    },
    "half_orc_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some half-orcs rise to become proud leaders of orc communities. Some venture into the world to prove their worth. Many of these become adventurers, achieving greatness for their mighty deeds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos semiorcos crecen para convertirse en jefes orgullosos de tribus orcas. Algunos se aventuran en el mundo para probar su valía . Muchos de estos se convierten en aventureros, cosechando grandeza por sus grandes hazañas."
          }
        }
      }
    },
    "half_orc_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Half-Orc"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semiorco"
          }
        }
      }
    },
    "half_orc_racial_traits" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+2 Strength, +1 Constitution, Darkvision, Menacing, Relentless Endurance, Savage Attacks"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+2 Fuerza, +1 Constitución, Visión en la Oscuridad, Amenazante, Resistencia Incansable, Ataques Salvajes"
          }
        }
      }
    },
    "halfling_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The diminutive halflings survive in a world full of larger creatures by avoiding notice or, barring that, avoiding offense."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los medianos sobreviven en un mundo lleno de criaturas más grandes evitando ser detectados o, si eso no es posible, evitando los problemas."
          }
        }
      }
    },
    "halfling_name" : {
