    "necromancy_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necromancy"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nigromancia"
          }
        }
      }
    },
    "neutral_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is the alignment of those who prefer to steer clear of moral questions and don’t take sides, doing what seems best at the time. Lizardfolk, most druids, and many humans are neutral."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es el alineamiento de aquellos que prefieren mantenerse al margen de cuestiones morales y no pertenecer a ningún bando, haciendo lo que ellos creen que es lo mejor en cada momento. Los hombres lagarto, la mayoría de los druidas, y muchos humanos son neutrales."
          }
        }
      }
    },
    "neutral_evil_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is the alignment of those who do whatever they can get away with, without compassion or qualms. Many drow, some cloud giants, and yugoloths are neutral evil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es el alineamiento de aquellos que hacen lo que sea necesario para salirse con la suya, sin compasión ni escrúpulos. Muchos drow, algunos gigantes de las nubes, y yugoloths son neutrales malvados."
          }
        }
      }
    },
    "neutral_evil_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutral Evil"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutral Malvado"
          }
        }
      }
    },
    "neutral_good_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folk do the best they can to help others according to their needs. Many celestials, some cloud giants, and most gnomes are neutral good."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La gente hace lo que puede para ayudar a los demás de acuerdo a sus necesidades. Muchos celestiales, algunos gigantes de las nubes, y la mayoría de los gnomos son neutrales buenos."
          }
        }
      }
    },
    "neutral_good_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutral Good"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutral Bueno"
          }
        }
      }
    },
