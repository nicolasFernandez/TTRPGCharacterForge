    "chaotic_evil_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creatures act with arbitrary violence, spurred by their greed, hatred, or bloodlust. Demons, red dragons, and orcs are chaotic evil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las criaturas actúan con una violencia arbitraria, impulsados por su codicia, su odio o su sed de sangre. Los demonios, dragones rojos, y orcos son caóticos malignos."
          }
        }
      }
    },
    "chaotic_evil_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaotic Evil"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaótico Malvado"
          }
        }
      }
    },
    "chaotic_good_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creatures act as their conscience directs, with little regard for what others expect. Copper dragons, many elves, and unicorns are chaotic good."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las criaturas actúan según les dicta su conciencia, sin preocuparse por lo que esperan los demás. Los dragones de bronce, muchos elfos, y los unicornios son caóticos buenos."
          }
        }
      }
    },
    "chaotic_good_name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaotic Good"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caótico Bueno"
          }
        }
      }
    },
    "chaotic_neutral_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creatures follow their whims, holding their personal freedom above all else. Many barbarians and rogues, and some bards, are chaotic neutral."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas criaturas hacen lo que les apetece, valorando su libertad por encima de todo. Muchos bárbaros y pícaros, y algunos bardos, son caóticos neutrales."
          }
        }
      }
    },
    "chaotic_neutral_name" : {
      "extractionState" : "manual",
